{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen3-tts-triton.local/schemas/triton_manifest.schema.json",
  "title": "Triton deployment manifest",
  "type": "object",
  "required": ["schema_version", "variant"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Manifest format version"
    },
    "variant": {
      "type": "string",
      "description": "Model variant id (e.g. custom-1.7b)"
    },
    "engine_mode": {
      "type": "string",
      "enum": ["onnx", "trt"],
      "description": "Default engine mode for assembled repo"
    },
    "engine_dtype": {
      "type": "string",
      "enum": ["bf16", "fp16", "fp32", "fp8", "bfloat16", "float16", "float32", "float8"],
      "description": "TensorRT builder precision (trtexec --bf16/--fp16/--fp8); Phase B fused build reads this from manifest; must stay in sync with rebuilt engine"
    },
    "triton_io_float_dtype": {
      "type": "string",
      "enum": ["fp32", "bf16", "fp16", "fp8", "float32", "bfloat16", "float16", "float8"],
      "description": "Float I/O for talker_code2wav_fused: trtexec --inputIOFormats/--outputIOFormats + Triton TYPE_* + BLS torch dtype; export_09 default bf16; ONNX file stays FP32"
    },
    "backbone_precision": {
      "type": "string",
      "enum": ["fp32", "bf16", "fp16", "fp8"],
      "description": "Backbone (talker_unified + codec_sum) compute precision; defaults to engine_dtype if unspecified"
    },
    "cp_precision": {
      "type": "string",
      "enum": ["fp32", "bf16", "fp16", "fp8"],
      "description": "Code Predictor compute precision; set to fp32 to mitigate BF16 numerical sensitivity"
    },
    "code2wav_precision": {
      "type": "string",
      "enum": ["fp32", "bf16", "fp16", "fp8"],
      "description": "Code2Wav decoder compute precision; defaults to engine_dtype if unspecified"
    },
    "engine_profile": {
      "type": "object",
      "description": "Actual TensorRT profile and build metadata used by Phase B",
      "properties": {
        "profile_schema_version": { "type": "integer" },
        "builder": { "type": "string" },
        "engine_mode": {
          "type": "string",
          "enum": ["onnx", "trt"]
        },
        "engine_dtype": {
          "type": "string",
          "enum": ["bf16", "fp16", "fp32", "fp8", "bfloat16", "float16", "float32", "float8"]
        },
        "triton_io_float_dtype": {
          "type": "string",
          "enum": ["fp32", "bf16", "fp16", "fp8", "float32", "bfloat16", "float16", "float8"]
        },
        "backbone_precision": {
          "type": "string",
          "enum": ["fp32", "bf16", "fp16", "fp8"],
          "description": "Backbone compute precision used during build"
        },
        "cp_precision": {
          "type": "string",
          "enum": ["fp32", "bf16", "fp16", "fp8"],
          "description": "CP compute precision used during build"
        },
        "code2wav_precision": {
          "type": "string",
          "enum": ["fp32", "bf16", "fp16", "fp8"],
          "description": "Code2Wav compute precision used during build"
        },
        "max_batch_size": { "type": "integer", "minimum": 1 },
        "max_input_len": { "type": "integer", "minimum": 1 },
        "max_seq_len": { "type": "integer", "minimum": 1 },
        "builder_image": { "type": "string" },
        "target_driver": { "type": "string" },
        "built_at_utc": { "type": "string" }
      },
      "additionalProperties": true
    },
    "submodels": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "description": "Optional flags for which logical models exist (assemble may still scan repo)"
    },
    "talker": {
      "type": "object",
      "description": "Talker dimensions for explicit TRT config (talker_unified)",
      "properties": {
        "hidden_size": { "type": "integer" },
        "num_kv_heads": { "type": "integer" },
        "head_dim": { "type": "integer" },
        "num_layers": { "type": "integer" },
        "vocab_size": { "type": "integer" }
      }
    },
    "code2wav_fused": {
      "type": "object",
      "description": "Fused talker+code2wav state I/O (export_09)",
      "properties": {
        "num_code2wav_hidden_layers": { "type": "integer" },
        "c2w_state_input_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "c2w_state_output_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "initial_state_shapes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "packed_kv": { "type": "boolean" },
        "c2w_kv_heads": { "type": "integer" },
        "c2w_head_dim": { "type": "integer" },
        "c2w_sliding_window": { "type": "integer" },
        "logits_topk": { "type": "integer" },
        "cp_num_stages": { "type": "integer" }
      }
    },
    "orchestrator": {
      "type": "object",
      "description": "tts_orchestrator config.pbtxt parameters",
      "additionalProperties": { "type": "string" }
    },
    "io_overrides": {
      "type": "object",
      "description": "Reserved for per-model I/O exceptions",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
