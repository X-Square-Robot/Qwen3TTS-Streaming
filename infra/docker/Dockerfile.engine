# Standalone TTS engine: NVIDIA PyTorch base + app deps + bundled code.
# Large artifacts are NOT baked in; mount the shared model_repository at runtime.
#
# The monthly NVIDIA PyTorch image already contains a mutually tested CUDA,
# PyTorch and TensorRT stack.  Do not pip-install another CUDA PyTorch wheel on
# top: that duplicates several GiB of CUDA libraries and can mix CUDA minors.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.02-py3
ARG PIP_INDEX_URL=https://mirrors.bfsu.edu.cn/pypi/web/simple
FROM ${BASE_IMAGE} AS engine-deps
ARG PIP_INDEX_URL

WORKDIR /app
ENV PYTHONPATH=/app

# Install only application-level dependencies missing from the NVIDIA base.
# BuildKit keeps these wheels in the build cache; tag CI additionally exports
# inline cache metadata to its container registry so ephemeral DinD jobs can
# reuse this layer.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    --timeout 120 \
    --retries 10 \
    --index-url "${PIP_INDEX_URL}" \
    filelock \
    fsspec \
    jinja2 \
    mpmath \
    networkx \
    sympy \
    tokenizers \
    pyyaml \
    numpy \
    'soxr>=1,<2' \
    aiohttp \
    grpcio \
    grpcio-tools \
    uvloop \
    orjson \
    && python3 -c "\
import os; \
import tensorrt as trt; \
import torch, tokenizers, yaml, grpc, numpy, soxr; \
base_cuda = '.'.join(os.environ.get('CUDA_VERSION', '').split('.')[:2]); \
torch_cuda = '.'.join((torch.version.cuda or '').split('.')[:2]); \
assert base_cuda and torch_cuda == base_cuda, f'base CUDA {base_cuda}, torch CUDA {torch.version.cuda}'; \
print(f'TRT {trt.__version__}'); \
print(f'torch {torch.__version__}, CUDA {torch.version.cuda}'); \
print(f'tokenizers {tokenizers.__version__}'); \
print(f'grpcio {grpc.__version__}')"

FROM engine-deps AS engine-runtime

# Release stamp (injected by local compose or directly by tag CI).
# Surfaces as capabilities.engine_version and in `docker inspect` — the
# pairing key between a deployed engine and its matching client SDK wheel.
ARG ENGINE_VERSION=""
ARG CLIENT_WHEEL_FILENAME=""
ARG CLIENT_WHEEL_SHA256=""
ENV ENGINE_VERSION=${ENGINE_VERSION} \
    QWEN_LOG_DIR=/var/log/qwen3tts \
    QWEN_LOG_MAX_BYTES=52428800 \
    QWEN_LOG_BACKUP_COUNT=10 \
    QWEN_LOG_STDOUT=1
LABEL org.opencontainers.image.version=${ENGINE_VERSION} \
      io.qwen3tts.client-wheel.filename=${CLIENT_WHEEL_FILENAME} \
      io.qwen3tts.client-wheel.sha256=${CLIENT_WHEEL_SHA256}

RUN install -d /etc/qwen3-tts /opt/qwen3tts/bin /var/log/qwen3tts

COPY engine.yaml /app/engine.yaml
COPY engine.yaml /etc/qwen3-tts/engine.yaml
COPY engine/ /app/engine/
COPY scripts/compose/ /app/scripts/compose/
COPY scripts/compose/rotating_log_runner.py /opt/qwen3tts/bin/rotating_log_runner.py
# The engine imports the shared protocol dataclasses (engine/interface/*
# → ``import qwen3tts_protocol``).  They ship in the qwen3-tts-client package
# but are pure-stdlib, so vendor the package directly onto PYTHONPATH (=/app)
# instead of pulling the whole client dependency tree into the runtime image.
COPY client/src/qwen3tts_protocol/ /app/qwen3tts_protocol/
# Tag CI downloads the already-published SDK wheel into client/dist/; local
# compose builds stage a development wheel there. It is served at GET /sdk/ on
# the health port. Release builds pass its filename and SHA256 and fail closed
# if the registry artifact is missing or changed.
COPY client/dist/ /app/sdk/
RUN if [ -n "${CLIENT_WHEEL_FILENAME}" ] || [ -n "${CLIENT_WHEEL_SHA256}" ]; then \
        test -n "${CLIENT_WHEEL_FILENAME}" && \
        test -n "${CLIENT_WHEEL_SHA256}" && \
        test "$(find /app/sdk -maxdepth 1 -type f -name 'qwen3_tts_client-*.whl' | wc -l)" -eq 1 && \
        test -f "/app/sdk/${CLIENT_WHEEL_FILENAME}" && \
        printf '%s  %s\n' "${CLIENT_WHEEL_SHA256}" "/app/sdk/${CLIENT_WHEEL_FILENAME}" | sha256sum -c -; \
    fi

# Keep the NVIDIA base image's ENTRYPOINT: it performs container/GPU runtime
# initialization before executing this command.  Compose and the direct Docker
# helpers pass the same wrapper explicitly when overriding CMD.
CMD ["python3", "/opt/qwen3tts/bin/rotating_log_runner.py", "--service", "engine", "--", "/bin/bash", "/app/scripts/compose/engine-entrypoint.sh"]
