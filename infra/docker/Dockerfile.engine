# Standalone TTS engine: TRT base + Python deps + bundled application code.
# Large artifacts are NOT baked in; mount the shared model_repository at runtime.
#
# Layer order: pip deps (cached by Docker if unchanged) then COPY app.
# Rebuilds after only editing engine/ reuse the deps layer — no re-download.
# For repeated clean builds on the same host, enable BuildKit + pip cache mount
# (see RUN below): wheels stay under Docker's build cache, not in the image.
ARG BASE_IMAGE=nvcr.io/nvidia/tensorrt:26.02-py3
ARG PYTORCH_CUDA_TAG=cu130
FROM ${BASE_IMAGE} AS engine-deps
ARG PYTORCH_CUDA_TAG

WORKDIR /app
ENV PYTHONPATH=/app \
    ENGINE_PYTORCH_CUDA_TAG=${PYTORCH_CUDA_TAG}

# BuildKit: persist ~/.cache/pip across builds so torch/grpc wheels are not re-fetched every time.
# Requires: DOCKER_BUILDKIT=1 (set in engine_build_image).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    -i https://mirrors.bfsu.edu.cn/pypi/web/simple \
    --trusted-host mirrors.bfsu.edu.cn \
    filelock \
    fsspec \
    jinja2 \
    mpmath \
    networkx \
    sympy \
    tokenizers \
    pyyaml \
    numpy \
    aiohttp \
    grpcio \
    grpcio-tools \
    && pip install \
    --timeout 120 \
    --retries 10 \
    --index-url https://download.pytorch.org/whl/${PYTORCH_CUDA_TAG} \
    torch \
    && python3 -c "\
import tensorrt as trt; \
import torch, tokenizers, yaml, grpc, numpy; \
print(f'TRT {trt.__version__}'); \
print(f'torch {torch.__version__}, CUDA {torch.version.cuda}'); \
print(f'tokenizers {tokenizers.__version__}'); \
print(f'grpcio {grpc.__version__}')"

FROM engine-deps AS engine-runtime

RUN mkdir -p /etc/qwen3-tts

COPY engine.yaml /app/engine.yaml
COPY engine.yaml /etc/qwen3-tts/engine.yaml
COPY engine/ /app/engine/
COPY scripts/compose/ /app/scripts/compose/
