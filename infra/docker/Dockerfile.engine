# Standalone TTS engine: TRT base + Python deps + bundled application code.
# Large artifacts are NOT baked in; mount the shared model_repository at runtime.
#
# Layer order: pip deps (cached by Docker if unchanged) then COPY app.
# Rebuilds after only editing engine/ reuse the deps layer — no re-download.
# For repeated clean builds on the same host, enable BuildKit + pip cache mount
# (see RUN below): wheels stay under Docker's build cache, not in the image.
ARG BASE_IMAGE=nvcr.io/nvidia/tensorrt:26.02-py3
ARG PYTORCH_CUDA_TAG=cu130
FROM ${BASE_IMAGE} AS engine-deps
ARG PYTORCH_CUDA_TAG

WORKDIR /app
ENV PYTHONPATH=/app \
    ENGINE_PYTORCH_CUDA_TAG=${PYTORCH_CUDA_TAG}

# BuildKit: persist ~/.cache/pip across builds so torch/grpc wheels are not re-fetched every time.
# Requires: DOCKER_BUILDKIT=1 (set in engine_build_image).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    -i https://mirrors.bfsu.edu.cn/pypi/web/simple \
    --trusted-host mirrors.bfsu.edu.cn \
    filelock \
    fsspec \
    jinja2 \
    mpmath \
    networkx \
    sympy \
    tokenizers \
    pyyaml \
    numpy \
    aiohttp \
    grpcio \
    grpcio-tools \
    uvloop \
    orjson \
    && pip install \
    --timeout 120 \
    --retries 10 \
    --index-url https://download.pytorch.org/whl/${PYTORCH_CUDA_TAG} \
    torch \
    && python3 -c "\
import tensorrt as trt; \
import torch, tokenizers, yaml, grpc, numpy; \
print(f'TRT {trt.__version__}'); \
print(f'torch {torch.__version__}, CUDA {torch.version.cuda}'); \
print(f'tokenizers {tokenizers.__version__}'); \
print(f'grpcio {grpc.__version__}')"

FROM engine-deps AS engine-runtime

# Release stamp (git describe at build time, injected by compose.sh).
# Surfaces in /health responses and `docker inspect` — the pairing key
# between a deployed engine and its matching client SDK wheel.
ARG ENGINE_VERSION=""
ENV ENGINE_VERSION=${ENGINE_VERSION} \
    QWEN_LOG_DIR=/var/log/qwen3tts \
    QWEN_LOG_MAX_BYTES=52428800 \
    QWEN_LOG_BACKUP_COUNT=10 \
    QWEN_LOG_STDOUT=1
LABEL org.opencontainers.image.version=${ENGINE_VERSION}

RUN install -d /etc/qwen3-tts /opt/qwen3tts/bin /var/log/qwen3tts

COPY engine.yaml /app/engine.yaml
COPY engine.yaml /etc/qwen3-tts/engine.yaml
COPY engine/ /app/engine/
COPY scripts/compose/ /app/scripts/compose/
COPY scripts/compose/rotating_log_runner.py /opt/qwen3tts/bin/rotating_log_runner.py
# The engine imports the shared protocol dataclasses (engine/interface/*
# → ``import qwen3tts_protocol``).  They ship in the qwen3-tts-client package
# but are pure-stdlib, so vendor the package directly onto PYTHONPATH (=/app)
# instead of pulling the whole client dependency tree into the runtime image.
COPY client/src/qwen3tts_protocol/ /app/qwen3tts_protocol/
# Client SDK wheel(s) built from this same checkout (staged into client/dist/
# by compose.sh before the build). Served at GET /sdk/ on the health port so a
# deployment always hands out the SDK version that matches it. The directory
# is committed (with .gitkeep) so this COPY works even when no wheel is staged.
COPY client/dist/ /app/sdk/

# Keep the NVIDIA base image's ENTRYPOINT: it performs container/GPU runtime
# initialization before executing this command.  Compose and the direct Docker
# helpers pass the same wrapper explicitly when overriding CMD.
CMD ["python3", "/opt/qwen3tts/bin/rotating_log_runner.py", "--service", "engine", "--", "/bin/bash", "/app/scripts/compose/engine-entrypoint.sh"]
