# Phase C deploy image: Triton py3 + pip deps + bundled engine/ (optional import fallback).
# Runtime still mounts workspace/model_repository for weights/engines (see triton_run).
#
# Order: RUN pip first (layer cached when deps unchanged), COPY engine/ last (code edits cheap).
# BuildKit pip cache: DOCKER_BUILDKIT=1 (see build_triton_deploy_image in docker.sh).
ARG BASE_IMAGE=nvcr.io/nvidia/tritonserver:26.02-py3
ARG TENSORRT_PYTHON_VERSION=10.15.1.29
ARG PYTORCH_CUDA_TAG=cu130
FROM ${BASE_IMAGE} AS triton-deps
ARG TENSORRT_PYTHON_VERSION
ARG PYTORCH_CUDA_TAG

# torch/tokenizers/... resolve fine from the fast BFSU mirror.
# tensorrt does NOT: its cu13 libs/bindings wheels live only on NVIDIA's index,
# and the BFSU mirror lacks them, so pip falls back to a source stub that hangs
# at build time. Install it separately from public PyPI + pypi.nvidia.com, using
# the same CUDA-13 runtime-first, --no-deps recipe as scripts/bash/lib/pip.sh
# (10.13.3.x metadata otherwise pulls a deprecated cuda-runtime source package).
# Triton 26.02 also ships an aiohttp installation without its ``attrs`` runtime
# dependency. Keep attrs explicit and import-probe both modules before the image
# can advance to the release smoke test.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    -i https://mirrors.bfsu.edu.cn/pypi/web/simple \
    --trusted-host mirrors.bfsu.edu.cn \
    --extra-index-url https://download.pytorch.org/whl/${PYTORCH_CUDA_TAG} \
    torch \
    tokenizers \
    pyyaml \
    numpy \
    'soxr>=1,<2' \
    grpcio \
    attrs \
    aiohttp \
    "tritonclient[grpc]>=2.54.0" \
    && pip install \
    --index-url https://pypi.org/simple \
    --extra-index-url https://pypi.nvidia.com \
    --trusted-host pypi.org \
    --trusted-host pypi.nvidia.com \
    nvidia-cuda-runtime==13.0.96 \
    && pip install --no-deps \
    --index-url https://pypi.org/simple \
    --extra-index-url https://pypi.nvidia.com \
    --trusted-host pypi.org \
    --trusted-host pypi.nvidia.com \
    "tensorrt==${TENSORRT_PYTHON_VERSION}" \
    "tensorrt_cu13_bindings==${TENSORRT_PYTHON_VERSION}" \
    "tensorrt_cu13_libs==${TENSORRT_PYTHON_VERSION}" \
    "tensorrt-cu13==${TENSORRT_PYTHON_VERSION}" \
    && python3 -c "\
import aiohttp, attr, torch, tokenizers, tensorrt, yaml, grpc, numpy, soxr; \
print(f'torch {torch.__version__}, CUDA {torch.version.cuda}'); \
print(f'tokenizers {tokenizers.__version__}'); \
print(f'tensorrt {tensorrt.__version__}'); \
print(f'grpcio {grpc.__version__}, pyyaml {yaml.__version__}, numpy {numpy.__version__}')"

FROM triton-deps AS triton-runtime

ARG ENGINE_VERSION=""
ARG CLIENT_WHEEL_FILENAME=""
ARG CLIENT_WHEEL_SHA256=""
ARG BROWSER_SDK_VERSION=""
ARG BROWSER_SDK_REGISTRY_URL=""
ARG BROWSER_SDK_TARBALL_URL=""
ENV ENGINE_VERSION=${ENGINE_VERSION} \
    BROWSER_SDK_VERSION=${BROWSER_SDK_VERSION} \
    BROWSER_SDK_REGISTRY_URL=${BROWSER_SDK_REGISTRY_URL} \
    BROWSER_SDK_TARBALL_URL=${BROWSER_SDK_TARBALL_URL} \
    DEMO_SITE_DIR=/app/demo \
    QWEN_LOG_DIR=/var/log/qwen3tts \
    QWEN_LOG_MAX_BYTES=52428800 \
    QWEN_LOG_BACKUP_COUNT=10 \
    QWEN_LOG_STDOUT=1
LABEL org.opencontainers.image.version=${ENGINE_VERSION} \
      io.qwen3tts.client-wheel.filename=${CLIENT_WHEEL_FILENAME} \
      io.qwen3tts.client-wheel.sha256=${CLIENT_WHEEL_SHA256} \
      io.qwen3tts.browser-sdk.version=${BROWSER_SDK_VERSION}

RUN install -d /opt/qwen3tts/bin /var/log/qwen3tts

COPY engine/ /opt/qwen3-tts/engine/
COPY client/src/qwen3tts_protocol/ /opt/qwen3-tts/qwen3tts_protocol/
COPY scripts/compose/rotating_log_runner.py /opt/qwen3tts/bin/rotating_log_runner.py
RUN install -d /app/sdk && rm -f /app/sdk/*.whl
COPY client/dist/ /app/sdk/
COPY web/packages/demo/dist/ /app/demo/
RUN test -s /app/demo/index.html || { \
        echo "Demo artifact missing: build web/packages/demo/dist before the runtime image" >&2; \
        exit 1; \
    }
RUN test "$(find /app/demo/downloads -maxdepth 1 -type f -name 'xmultimodalinteraction-qwen3tts-browser-*.tgz' | wc -l)" -eq 1 || { \
        echo "Browser SDK tarball missing or ambiguous: package it before the runtime image" >&2; \
        exit 1; \
    }
RUN if [ -n "${CLIENT_WHEEL_FILENAME}" ] || [ -n "${CLIENT_WHEEL_SHA256}" ]; then \
        test -n "${CLIENT_WHEEL_FILENAME}" && \
        test -n "${CLIENT_WHEEL_SHA256}" && \
        test "$(find /app/sdk -maxdepth 1 -type f -name 'qwen3_tts_client-*.whl' | wc -l)" -eq 1 && \
        test -f "/app/sdk/${CLIENT_WHEEL_FILENAME}" && \
        printf '%s  %s\n' "${CLIENT_WHEEL_SHA256}" "/app/sdk/${CLIENT_WHEEL_FILENAME}" | sha256sum -c -; \
    fi

# Preserve the NGC image's NVIDIA entrypoint and make a bare `docker run`
# capture Triton plus Python-backend output into the in-container log ring.
CMD ["python3", "/opt/qwen3tts/bin/rotating_log_runner.py", "--service", "triton", "--", "tritonserver", "--model-repository=/models", "--strict-model-config=false", "--log-verbose=0"]
