MODEL_VARIANT=custom-1.7b

# Standalone engine runtime mounts
ENGINE_MODELS_DIR=./workspace/models
ENGINE_EXPORTED_DIR=./workspace/exported

# Triton runtime mounts
TRITON_MODEL_REPO_DIR=./workspace/model_repository

# Ports
ENGINE_GRPC_PORT=50051
ENGINE_HEALTH_PORT=8080
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002

# Optional runtime tuning
ENGINE_DEVICE=0
ENGINE_MAX_BATCH_SIZE=64
ENGINE_MAX_SESSIONS=128
# /health probe semantics: ready (503 until engine ready, default) | alive (always 200)
# ENGINE_HEALTH_PROBE_MODE=ready
TRITON_MAX_BATCH_SLOTS=64
TRITON_MAX_SESSIONS=128
