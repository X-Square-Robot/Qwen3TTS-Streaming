workspace/
*__pycache__*
*.log
*.bak
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
# client/dist/ stays tracked (empty, via .gitkeep) so Dockerfile.engine's
# COPY client/dist/ works whether or not a wheel has been staged.
!client/dist/
client/dist/*
!client/dist/.gitkeep
client/build/
client/src/qwen3tts/_version.py
webui/node_modules/
webui/dist/
webui/tsconfig.tsbuildinfo
*.egg-info

# Local / secrets / tooling dotfiles (NOT a blanket ".*", which would also
# hide .github/, .gitmodules, .env.example, etc.)
.env
.venv/
venv/
.cache/
.DS_Store
.idea/
.claude/
.vscode/*
!.vscode/launch.json
